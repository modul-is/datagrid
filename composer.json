{
	"name": "modul-is/datagrid",
	"type": "library",
	"description": "Simple datagrid for Nette - Nette Database Selection as the source, rendered for Bootstrap 6",
	"keywords": ["php", "nette", "datagrid", "grid", "bootstrap", "bs6"],
	"homepage": "https://github.com/modul-is/datagrid",
	"license": "MIT",
	"require":
	{
		"php": "^8.4",
		"nette/application": "^3.2",
		"nette/database": "^3.2",
		"nette/forms": "^3.3",
		"nette/utils": "^4.0",
		"latte/latte": "^3.1",
		"modul-is/form": "dev-bs6"
	},
	"require-dev":
	{
		"phpstan/phpstan-nette": "^2",
		"modul-is/coding-standard": "^5",
		"nette/tester": "^2.6",
		"nette/bootstrap": "^3.2",
		"nette/di": "^3.2",
		"nette/http": "^3.3",
		"tracy/tracy": "^2.10"
	},
	"suggest":
	{
		"nette/di": "for configuration by ModulIS\\Datagrid\\DI\\DatagridExtension"
	},
	"autoload":
	{
		"classmap": ["src/"]
	},
	"autoload-dev":
	{
		"classmap": ["demo/app/"]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config":
	{
		"allow-plugins":
		{
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
